config {
  type: "table",
  schema: "canonical",
  name: "int_order_payment_summary",
  description: "Internal one-row-per-order summary of staged Olist payment counts and monetary values.",
  tags: ["canonical", "olist", "intermediate"],
  columns: {
    source_order_id: "Preserved source order_id and summary grain.",
    payment_count: "Number of staged payment observations.",
    payment_total: "Sum of preserved payment values."
  }
}

SELECT
  order_id AS source_order_id,
  COUNT(*) AS payment_count,
  SUM(payment_value) AS payment_total
FROM ${ref("stg_payments")}
GROUP BY order_id