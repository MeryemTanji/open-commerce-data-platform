config {
  type: "assertion",
  name: "assert_stg_order_items_cast_validity",
  description: "Fails when a non-empty Olist order-item value cannot be converted to its contracted semantic type."
}

SELECT
  'order_item_id' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("order_items")}
WHERE
  NULLIF(TRIM(order_item_id), '') IS NOT NULL
  AND SAFE_CAST(TRIM(order_item_id) AS INT64) IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  'shipping_limit_date' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("order_items")}
WHERE
  NULLIF(TRIM(shipping_limit_date), '') IS NOT NULL
  AND SAFE_CAST(TRIM(shipping_limit_date) AS TIMESTAMP) IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  'price' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("order_items")}
WHERE
  NULLIF(TRIM(price), '') IS NOT NULL
  AND SAFE_CAST(TRIM(price) AS NUMERIC) IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  'freight_value' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("order_items")}
WHERE
  NULLIF(TRIM(freight_value), '') IS NOT NULL
  AND SAFE_CAST(TRIM(freight_value) AS NUMERIC) IS NULL
HAVING COUNT(*) > 0