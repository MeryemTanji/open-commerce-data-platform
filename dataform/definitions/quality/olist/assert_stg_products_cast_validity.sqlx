config {
  type: "assertion",
  name: "assert_stg_products_cast_validity",
  description: "Fails when a non-empty Olist product value cannot be converted to its contracted semantic type."
}

SELECT
  'product_name_lenght' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("products")}
WHERE
  NULLIF(TRIM(product_name_lenght), '') IS NOT NULL
  AND SAFE_CAST(TRIM(product_name_lenght) AS INT64) IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  'product_description_lenght' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("products")}
WHERE
  NULLIF(TRIM(product_description_lenght), '') IS NOT NULL
  AND SAFE_CAST(TRIM(product_description_lenght) AS INT64) IS NULL
HAVING COUNT(*) > 0

UNION ALL

