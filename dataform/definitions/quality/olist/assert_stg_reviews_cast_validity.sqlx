config {
  type: "assertion",
  name: "assert_stg_reviews_cast_validity",
  description: "Fails when a non-empty Olist review value cannot be converted to its contracted semantic type."
}

SELECT
  'review_score' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("reviews")}
WHERE
  NULLIF(TRIM(review_score), '') IS NOT NULL
  AND SAFE_CAST(TRIM(review_score) AS INT64) IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  'review_creation_date' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("reviews")}
WHERE
  NULLIF(TRIM(review_creation_date), '') IS NOT NULL
  AND SAFE_CAST(TRIM(review_creation_date) AS TIMESTAMP) IS NULL
HAVING COUNT(*) > 0

UNION ALL

SELECT
  'review_answer_timestamp' AS invalid_field,
  COUNT(*) AS invalid_value_count
FROM ${ref("reviews")}
WHERE
  NULLIF(TRIM(review_answer_timestamp), '') IS NOT NULL
  AND SAFE_CAST(TRIM(review_answer_timestamp) AS TIMESTAMP) IS NULL
HAVING COUNT(*) > 0