config {
  type: "assertion",
  schema: "canonical",
  name: "assert_fct_order_items_identity_contract",
  description: "Blocks publication when canonical order-item identity is inconsistent with its source namespace, source identifiers, or deterministic key generation.",
  dependencies: ["fct_order_items"]
}

SELECT
  *
FROM ${ref("fct_order_items")}
WHERE
  source_namespace != "olist"

  OR order_item_key
    != TO_HEX(
      SHA256(
        TO_JSON_STRING(
          STRUCT(
            "v1" AS key_version,
            "order_item" AS entity_type,
            "olist" AS source_namespace,
            CAST(source_order_id AS STRING)
              AS source_identifier_1,
            CAST(source_order_item_id AS STRING)
              AS source_identifier_2
          )
        )
      )
    )