config {
  type: "assertion",
  schema: "canonical",
  name: "assert_fct_order_items_grain",
  description: "Blocks publication when the canonical order-item fact violates its declared identity or source grain.",
  dependencies: ["fct_order_items"]
}

WITH metrics AS (
  SELECT
    (
      SELECT COUNT(*)
      FROM ${ref("fct_order_items")}
      WHERE
        order_item_key IS NULL
        OR source_namespace IS NULL
        OR source_order_id IS NULL
        OR source_order_item_id IS NULL
    ) AS rows_with_null_identity,

    (
      SELECT COUNT(*)
      FROM (
        SELECT
          order_item_key
        FROM ${ref("fct_order_items")}
        GROUP BY order_item_key
        HAVING COUNT(*) > 1
      )
    ) AS duplicate_order_item_keys,

    (
      SELECT COUNT(*)
      FROM (
        SELECT
          source_namespace,
          source_order_id,
          source_order_item_id
        FROM ${ref("fct_order_items")}
        GROUP BY
          source_namespace,
          source_order_id,
          source_order_item_id
        HAVING COUNT(*) > 1
      )
    ) AS duplicate_source_item_grains
)

SELECT
  failure_reason,
  affected_row_count
FROM metrics
CROSS JOIN UNNEST([
  STRUCT(
    "required order-item identity column is null"
      AS failure_reason,
    rows_with_null_identity
      AS affected_row_count
  ),
  STRUCT(
    "canonical order-item key is duplicated",
    duplicate_order_item_keys
  ),
  STRUCT(
    "source order-item grain is duplicated",
    duplicate_source_item_grains
  )
])
WHERE affected_row_count > 0