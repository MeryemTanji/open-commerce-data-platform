config {
  type: "assertion",
  schema: "canonical",
  name: "assert_fct_order_items_monetary_contract",
  description: "Blocks publication when required order-item monetary values are missing, negative, or internally inconsistent.",
  dependencies: ["fct_order_items"]
}

SELECT
  *
FROM ${ref("fct_order_items")}
WHERE
  unit_price IS NULL
  OR freight_value IS NULL
  OR item_total_value IS NULL

  OR unit_price < 0
  OR freight_value < 0
  OR item_total_value < 0

  OR item_total_value
    != unit_price + freight_value